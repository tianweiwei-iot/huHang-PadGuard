# 生产 .env 模板（复制为 .env 后填入真实值；.env 已 gitignore，严禁入库）
# 生成强随机值：openssl rand -hex 16（密码）/ openssl rand -hex 32（JWT）

# ---- PostgreSQL ----
# 注意：用户名绝不能留 "padguard"——ProdConfigAssertion 把该默认值判为弱口令并拒绝启动
# （PG_USER 同时是 app 的 SPRING_DATASOURCE_USERNAME）。请改成自定义用户名 + 强密码。
PG_DB=padguard
PG_USER=CHANGE_ME_custom_db_user
PG_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# ---- JWT（云端部署必须显式注入，ProdConfigAssertion 校验项）----
PADGUARD_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- MQTT（服务端连 broker 的凭据，对应 mosquitto/passwd 中的 pgserver 用户）----
PADGUARD_MQTT_USERNAME=pgserver
PADGUARD_MQTT_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# ---- MQTT（设备共享凭据，对应 passwd 中的 pgdevice 用户）----
# 注入服务端容器（DeviceService）→ 绑定时经 BindResult 自动下发给孩子端，App 无需手填凭据；
# 孩子端从公网连 ssl://你的域名:8883（MQTT over TLS，见 docs/生产部署TLS配置说明.md）。批次 D S1 收敛为 per-device。
PADGUARD_MQTT_DEVICE_USERNAME=pgdevice
PADGUARD_MQTT_DEVICE_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# ---- TLS（Nginx 反向代理终止 + MQTT 8883 TLS）----
# 证书由 scripts/gen-certs.sh 生成（自签名仅测试/内网；生产请换 Let's Encrypt 或商业证书）。
# 生成命令：bash scripts/gen-certs.sh 你的域名
#  · Nginx 证书目录：./nginx/certs（server.crt / server.key）
#  · Mosquitto 证书目录：./mosquitto/certs（ca.crt / server.crt / server.key）
# 部署后孩子端接入点填 https://你的域名/api/v1/ 与 ssl://你的域名:8883。

# ---- 高德 Web 服务 Key（服务端逆地理编码用，可选）----
# 与家长端 Android 平台 Key 是两套、不可互换；留空则定位只上报坐标、不做地址反查（不报错）。
PADGUARD_AMAP_WEB_KEY=

# ---- 邮件（管理员初始密码外发，可选）----
# 留空/关闭时仅记日志 + 后台弹窗显示明文口令，需人工转告。SMTP 已配置且 ENABLED=true 才真正发信。
PADGUARD_MAIL_ENABLED=false
PADGUARD_MAIL_FROM=no-reply@padguard.com
PADGUARD_MAIL_HOST=
PADGUARD_MAIL_PORT=465
PADGUARD_MAIL_USERNAME=
PADGUARD_MAIL_PASSWORD=

# ---- 微信支付 v3（真实渠道，按"采用微信支付"接入）----
# 全部留空 = 不启用（收银台该渠道置灰）。启用需同时填齐以下项。
# 凭证获取：微信商户平台 → 账户中心 → API 安全（下载 apiclient_cert.pem / apiclient_key.pem、设 APIv3 密钥、记序列号）。
# 注意：私钥/密钥属高敏感凭证，生产请用密钥管理注入，勿明文入库。
PADGUARD_BILLING_WECHAT_ENABLED=false
PADGUARD_BILLING_WECHAT_APP_ID=
PADGUARD_BILLING_WECHAT_MCH_ID=
PADGUARD_BILLING_WECHAT_SERIAL_NO=
# APIv3 密钥（32 字节）：推荐 Base64（长度 44）
PADGUARD_BILLING_WECHAT_API_V3_KEY=
# 商户 API 私钥全文（PKCS#8）。多行 PEM 直接放环境变量不便，更推荐用下方 PRIVATE_KEY_PATH 挂载密钥文件。
PADGUARD_BILLING_WECHAT_PRIVATE_KEY_PEM=
# 商户 API 私钥文件路径（PKCS#8 .pem）。生产推荐：把密钥文件挂进容器后填此处（与上面二选一，上面优先）。
PADGUARD_BILLING_WECHAT_PRIVATE_KEY_PATH=
# 支付结果异步回调地址（公网 HTTPS，须与商户平台配置一致）
PADGUARD_BILLING_WECHAT_NOTIFY_URL=
# 退款结果回调地址（可选；不填则退款以"申请受理成功"为准）
PADGUARD_BILLING_WECHAT_REFUND_NOTIFY_URL=
# 平台证书优先自动拉取（需私钥+序列号）；也可把 .pem 挂到目录后填此路径
PADGUARD_BILLING_WECHAT_PLATFORM_CERT_DIR=
