# 生产 .env 模板（复制为 .env 后填入真实值；.env 已 gitignore，严禁入库）
# 生成强随机值：openssl rand -hex 16（密码）/ openssl rand -hex 32（JWT）

# ---- PostgreSQL ----
PG_DB=padguard
PG_USER=padguard
PG_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# ---- JWT（云端部署必须显式注入，ProdConfigAssertion 校验项）----
PADGUARD_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- MQTT（服务端连 broker 的凭据，对应 mosquitto/passwd 中的 pgserver 用户）----
PADGUARD_MQTT_USERNAME=pgserver
PADGUARD_MQTT_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# ---- MQTT（设备共享凭据，对应 passwd 中的 pgdevice 用户）----
# 注入服务端容器（DeviceService）→ 绑定时经 BindResult 自动下发给孩子端，App 无需手填凭据；
# 孩子端仅需要在高级设置里填 broker 地址 tcp://8.148.68.183:1883。批次 D S1 收敛为 per-device。
PADGUARD_MQTT_DEVICE_USERNAME=pgdevice
PADGUARD_MQTT_DEVICE_PASSWORD=CHANGE_ME_openssl_rand_hex_16
