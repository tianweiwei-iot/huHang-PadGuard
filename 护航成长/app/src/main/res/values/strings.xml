<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">护航成长</string>

    <!-- 设备管理器停用前的威慑提示（PadGuardDeviceAdminReceiver.onDisableRequested 引用） -->
    <string name="admin_disable_warning">停用设备管理器将导致管控失效：孩子可自由安装游戏、修改系统时间绕过时长限制、卸载本应用。请谨慎操作，如为学校统一管控设备请勿停用。</string>

    <!-- 守护前台服务通知（GuardService 引用） -->
    <string name="guard_channel_name">护航成长守护</string>
    <string name="guard_channel_desc">后台持续守护与策略同步</string>
    <string name="guard_state_online">在线</string>
    <string name="guard_state_connecting">连接中</string>
    <string name="guard_state_offline">离线</string>
    <string name="guard_notification_title">护航成长守护中</string>
    <!-- 参数 1：连接状态文案；参数 2：管控模式（FAMILY / CAMPUS 等） -->
    <string name="guard_notification_text">状态：%1$s · 模式：%2$s</string>

    <!-- 操作闸门无障碍服务描述（设置 → 无障碍 列表项展示，必须说清用途） -->
    <string name="guard_accessibility_description">护航成长「操作密码闸门」需要此服务：当孩子尝试进入系统设置、卸载应用或安装未知来源应用时，服务会弹出家长密码框要求输入密码，未输入正确密码无法继续。本服务仅读取前台应用包名用于判断是否需要拦截，不会读取任何界面内容或隐私数据。</string>
</resources>
