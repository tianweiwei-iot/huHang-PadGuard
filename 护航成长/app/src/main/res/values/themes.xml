<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PadGuard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!--
      锁屏 / 拦截 / 消息三类覆盖层用的全屏主题。
      关键属性：
      - windowFullscreen：隐藏状态栏，杜绝从状态栏下拉逃逸；
      - windowLayoutInDisplayCutoutMode：适配刘海屏，避免覆盖层被挖孔遮挡。

      注意：锁屏置顶 / 点亮屏幕的能力（windowShowWhenLocked / windowTurnScreenOn）
      在 Android 框架里**不是**主题属性 —— 框架并未暴露 android:windowShowWhenLocked /
      android:windowTurnScreenOn 这两个 attr，无法在 styles.xml 中声明（会导致
      AAPT2 resource linking 失败）。这部分由 LockScreenActivity.showOverLockScreen()
      在代码里通过 setShowWhenLocked(true) / setTurnScreenOn(true)（API 27+，低版本
      回退到 FLAG_SHOW_WHEN_LOCKED / FLAG_TURN_SCREEN_ON）实现。
    -->
    <style name="Theme.PadGuard.Lock" parent="Theme.PadGuard">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <!--
      应用访问门禁（AppAccessGateActivity）用的**透明浮层**主题。

      与 Theme.PadGuard.Lock 的根本区别：Lock 是全屏覆盖（锁屏就该占满，杜绝从状态栏逃逸），
      而门禁只是桌面上浮出的一个对话框 —— 桌面必须保持可见，孩子/家长看到的应当是
      "桌面上弹了个密码框"，而不是"被带进了管控系统的某个页面"。

      关键属性：
      - windowIsTranslucent + windowBackground 透明：让背后的桌面透出来；
      - backgroundDimEnabled：给桌面加一层压暗，突出卡片，同时明确"当前不可操作桌面"；
      - windowContentOverlay=@null：去掉默认阴影/遮罩，避免透明窗口上出现灰底；
      - 状态栏保持可见（不设 windowFullscreen）：门禁不该伪装成锁屏，
        它只是短暂打断，保留状态栏能让孩子明白设备并未被锁死。
    -->
    <style name="Theme.PadGuard.Gate" parent="Theme.PadGuard">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <!--
      屏幕采集授权过渡页（CapturePermissionActivity）用的主题。
      关键修复（2026-10-21）：原 Theme.Translucent.NoTitleBar 让 EMUI 等国产 ROM 的
      "后台启动 Activity / 悬浮窗管控"把本页当成"后台弹窗"直接拦截，导致通知点开后
      系统「是否允许录制屏幕」确认框无法弹出、孩子无法确认授权（现场："点了通知却没反应"）。

      解法：改用"普通（非 translucent）主题 + 透明背景"（fake-transparent 技巧）——
      视觉上仍透明（系统确认框出现前孩子看不到我们的界面），但系统按"正规前台 Activity"
      对待，不再触发 OEM 的后台弹窗拦截，系统确认框必现且可点"立即开始"。
      注意：刻意不设置 android:windowIsTranslucent，否则又被当成透明浮窗拦截。
    -->
    <style name="Theme.PadGuard.Consent" parent="Theme.PadGuard">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
