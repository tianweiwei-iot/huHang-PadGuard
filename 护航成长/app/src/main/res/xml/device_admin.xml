<?xml version="1.0" encoding="utf-8"?>
<!--
  设备管理器策略声明（已按上架合规瘦身）。

  ## 定位：Device Owner 是可选增强，不是必需能力
  本产品在没有 Device Owner / 设备管理员身份时，全部管控能力（锁屏、应用黑白名单、
  时长管控、网址管控、实时看屏、录屏、定位、应用台账）照常工作。
  DO 只额外提供"防卸载 / 加固基线 / 禁用摄像头"这类**防绕过**增强项，
  装机时不强制、不阻断流程，装不上就降级运行。

  ## 为什么删掉这些策略
  · wipe-data：远程清空设备数据是应用市场审核的最高级红线，
    工信部与 Google Play 都会因此直接打回；本产品不需要它，恢复出厂应由家长手动操作。
  · limit-password / expire-password / reset-password / watch-login / encrypted-storage：
    密码策略类能力对家长管控无实际用途，却要在安装时向用户展示"本应用可更改你的锁屏密码"
    这类高危提示，是典型的"索取与功能无关的高权限"。

  ## 保留的三项与管控能力直接对应
  · force-lock：远程一键锁屏（家长端核心指令之一）
  · disable-keyguard-features：锁屏期间裁剪下拉通知/快捷设置，防止孩子绕过锁屏
  · disable-camera：策略禁用摄像头
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- 远程锁屏：lockNow() -->
        <force-lock />
        <!-- 禁用摄像头：setCameraDisabled() -->
        <disable-camera />
        <!-- 锁屏界面特性裁剪：setKeyguardDisabledFeatures() -->
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
