<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络与运行状态读取 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      定位（实时定位 / 电子围栏，说明书 §6.5）。

      ⚠️ 刻意**没有**声明 ACCESS_BACKGROUND_LOCATION，也不要给任何服务加
      `android:foregroundServiceType="location"` —— 这不是遗漏，是合规决策：
      1) ACCESS_BACKGROUND_LOCATION 属于 Google Play 受限权限，需专项申报；
      2) 更关键的是 **Play 家庭政策禁止面向儿童的 App 申请后台位置**，本 App 正是孩子端。

      代价与对策（已实现，勿绕回去）：Android 10(API29)+ 起，App 在后台**读不到位置**
      （getLastKnownLocation 会被直接拒绝），而本 App 的定位是在后台守护服务里响应
      家长指令触发的 —— 因此后台期间不读位置，而是登记待办，等界面回到前台时自动补传。
      详见 LocationCollector 类注释。
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      权限瘦身说明（上架合规）：

      以下权限**刻意不声明**，因为它们既非管控必需，又是应用市场审核的高危项：
      · READ_PHONE_STATE / READ_SMS / RECEIVE_SMS / SEND_SMS / READ_CALL_LOG
        ——短信与通话记录属最高敏感度权限，Google Play 有专门申报表、国内工信部
        专项整治也重点治理；本产品唯一的设备标识由服务端下发（bind 时生成 deviceId），
        完全不需要读 IMEI 或通信记录。
      · INSTALL_PACKAGES / DELETE_PACKAGES
        ——签名级系统权限，第三方应用声明了也不会被授予，只会触发市场"保留权限"警告。
        静默安装走 PackageInstaller 会话 + REQUEST_INSTALL_PACKAGES 即可。
      · REQUEST_DELETE_PACKAGES
        ——卸载用系统卸载确认页（ACTION_DELETE）即可，不需要任何权限。
      · REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
        ——Play 政策仅允许白名单类应用（默认短信/电话/辅助功能）使用，家长管控不在其中，
        声明即被拒；国内华为/小米也会因此打回。
      · QUERY_ALL_PACKAGES
        ——工信部与 Play 双重重点审核项。本产品只关心"孩子桌面上能打开的应用"，
        用 <queries> 声明启动器入口即可覆盖，无需全量包可见性。

      Device Owner / 设备管理员**不再作为必需能力**：它是可选增强（用于防卸载、
      加固基线等），未激活时全部管控能力照常工作，只是少了防卸载这类加固项。
    -->

    <!-- 摄像头 / 麦克风（远程拍照、远程录音、录屏含设备声音，说明书 §6.7 / §6.10） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 存储读写（日志 / 截图 / 下发文件，说明书 §6.8） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- NFC 近场绑定（说明书 §4.3 方式③） -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- 绑定阶段扫码（说明书 §4.3 方式①） -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!--
      应用台账采集：Android 11+ 有包可见性限制，但管控真正需要的只是
      "孩子桌面上能打开的应用"，用 <queries> 声明启动器入口即可完整覆盖，
      无需 QUERY_ALL_PACKAGES（上架高危权限）。
      同时声明 LEANBACK_LAUNCHER 以兼容平板/电视的桌面入口。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <!-- 开机 / 覆盖安装后自启守护服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 前台服务：常驻守护 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!--
      应用内安装：PackageInstaller 会话提交走 REQUEST_INSTALL_PACKAGES（普通权限，
      市场可申报）。卸载用系统卸载确认页，不需要任何权限。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      全局水印是悬浮窗覆盖层，必须有 SYSTEM_ALERT_WINDOW。
      注意：该权限不会随安装自动授予，需用户在系统设置中手动打开
      （WatermarkOverlay.isSupported() 会检测，未授权时水印静默降级并如实上报）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 13+ 通知运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      信息发布全屏霸屏：高优先级通知的 fullScreenIntent 需要此权限才能
      在 Android 12+ 后台自动拉起霸屏 Activity（普通权限，随安装授予）。
      配合已声明的 SYSTEM_ALERT_WINDOW，设备所有者/已授权悬浮窗的设备可零点击霸屏。
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      应用时长统计 / 单应用限额 / 黑名单事后拦截全都依赖前台应用探测，
      而探测唯一可靠的来源是 UsageStatsManager（见 ForegroundAppMonitor）。

      必须在这里声明：系统的「设置 → 特殊应用权限 → 使用情况访问」列表
      只收录**声明了该权限**的应用。缺了这行，引导页把用户送到设置页，
      列表里却找不到本应用 —— 用户怎么点都开不了，限额与用量统计永远为空。
      它是 AppOps 权限，不会随安装授予，仍需用户在设置页手动打开。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      锁屏/拦截覆盖层不需要 SYSTEM_ALERT_WINDOW：
      它们是普通 Activity（NEW_TASK 拉起），靠 setShowWhenLocked 在锁屏之上显示，
      属于系统豁免范围，不强制申请悬浮窗权限。
    -->

    <application
        android:name=".PadGuardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.PadGuard"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- 入口：设备绑定 / 状态查看（管理界面，由应用图标启动） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          孩子桌面（自定义 Launcher / 应用管控可视网关）。
          仅 HOME 类目、无 LAUNCHER：它不出现在应用抽屉里，只在孩子按 HOME 且被设为默认桌面时拉起，
          渲染白名单应用网格。保留 CATEGORY_DEFAULT 是为了让 KioskEnforcer.resolveOwnLauncher()
          能反查到本 HOME Activity（DO 下把本桌面设为常驻默认桌面）。
          本 Activity 也是 Kiosk / 防变砖的兜底：即便 DO 被清除，系统至少还有它可回退，不会开机无桌面。
        -->
        <activity
            android:name=".KidHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PadGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 设备绑定流程：在 MainActivity 检测到未绑定时拉起 -->
        <activity
            android:name=".bind.BindActivity"
            android:exported="false"
            android:theme="@style/Theme.PadGuard" />

        <!-- 扫码绑定页（说明书 §4.3 方式①） -->
        <activity
            android:name=".bind.QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PadGuard" />

        <!-- 锁屏覆盖层：无解锁入口 -->
        <activity
            android:name=".ui.lock.LockScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PadGuard.Lock" />

        <!-- 应用违规拦截覆盖层 -->
        <activity
            android:name=".ui.block.AppBlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PadGuard.Lock" />

        <!--
          操作密码解锁界面（设备操作闸门）。
          当孩子尝试进入系统设置 / 卸载应用 / 安装未知来源应用，且家长已开启操作密码时，
          无障碍服务会把家长挡在外面并拉起本界面；家长输对密码后开启 10 分钟解锁窗口。
          仅通过 NEW_TASK 由无障碍服务或 App 内部硬控拉起，不对外暴露。
        -->
        <activity
            android:name=".guard.GuardUnlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PadGuard" />

        <!-- 管理员消息/公告全屏弹窗 -->
        <activity
            android:name=".ui.message.MessageActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PadGuard.Lock" />

        <!-- 常驻守护服务（GuardService） -->
        <service
            android:name=".service.GuardService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <!-- API 34+ 用 specialUse 必须声明子类型理由，否则安装/启动报 SecurityException -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device management / parental-control guard service" />
        </service>

        <!--
          守护服务看门狗：由系统进程周期回调（应用进程被杀也照样回调），
          发现 GuardService 不在就把它拉起来 —— 只有这样才能做到"装了就能管控"。
          BIND_JOB_SERVICE 是 JobService 的强制权限，缺了系统不会回调。
        -->
        <service
            android:name=".service.GuardWatchdogService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          屏幕采集（截屏 / 录屏 / 录音）：
          API 29+ 起 MediaProjection 必须在带 mediaProjection 类型的前台服务里使用，
          否则 createVirtualDisplay 直接抛 SecurityException。
          录音额外需要 microphone 类型，故一并声明。
        -->
        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- 采集授权过渡页：无界面（透明），仅用于承接 MediaProjection 授权结果 -->
        <activity
            android:name=".capture.CapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 静默安装 / 卸载结果回调 -->
        <receiver
            android:name=".maintain.InstallResultReceiver"
            android:exported="false" />

        <!-- 设备管理器 / Device Owner 锚点 -->
        <!--
          exported 必须为 true：
          1) 系统「设置」进程要解析本组件并弹出"激活设备管理器"确认页；
             设为 false 时 Settings 解析不到，表现为点了激活【毫无反应】；
          2) 声明了 intent-filter 时默认就是 true，之前显式写 false 是错的；
          3) 安全性由 BIND_DEVICE_ADMIN 权限保证，不依赖 exported。
        -->
        <receiver
            android:name=".receiver.PadGuardDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 开机 / 覆盖安装广播：拉起守护服务 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 设备解锁：暖令牌最自然的触发点（应用此时在前台，可合法顶起系统确认框） -->
                <action android:name="android.intent.action.USER_PRESENT" />
                <!-- 部分国产 ROM 快速开机替代广播 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 霸屏通知被划掉后的兜底重发（见 MessageActivity.handleNotificationDeleted） -->
        <receiver
            android:name=".ui.message.MessageDismissReceiver"
            android:exported="false" />

        <!--
          操作闸门无障碍服务（软拦截核心）。
          监听前台窗口切换：当孩子/家长处于「系统设置 / 应用卸载确认 / 未知来源安装确认」
          且家长已开启操作密码且当前不在解锁窗口内时，弹出自家密码框（GuardUnlockActivity）
          并用 performGlobalAction(BACK) 把用户顶回，从而实现对「改设置 / 卸载 / 安装」的密码拦截。

          该服务不可靠地随安装自动开启：必须由用户在「设置 → 无障碍」中手动授权，
          因此 GuardService 会在密码启用但服务未开时持续提示引导。
          它不依赖设备所有者(DO)，存量 C 端平板同样可用。
        -->
        <service
            android:name=".guard.OperationGuardAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/operation_guard_accessibility" />
        </service>
    </application>
</manifest>
