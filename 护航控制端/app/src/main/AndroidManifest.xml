<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ 包可见性：不声明 <queries> 时 getPackageInfo("com.tencent.mm") 必抛
      NameNotFoundException —— 收银台会永远提示"未检测到微信客户端"，微信支付整体不可用。
      这里只声明微信，不申请 QUERY_ALL_PACKAGES。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Push notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      定位权限已移除（应用市场合规）：家长端的地图只展示孩子设备上报的坐标（由服务端下发），
      不读取本机位置、不开启高德 myLocation、无 requestPermissions 调用。
      声明却不使用的定位权限会被小米/OPPO 判为「过度申请敏感权限」而拒绝上架。
      若将来新增「定位到家长自己」功能，须补前置用途说明 + 运行时申请 + 隐私政策权限表条目后再加回。
    -->

    <!--
      明文传输开关保持 true —— 与孩子端同一决策，不是遗漏：
      家庭/校园局域网部署时服务端跑在内网（http + tcp），关掉会让家长端直接连不上；
      公网部署由 Nginx 终止 TLS，填 https:// 域名即走加密，本开关不影响其安全性。
      历史注释把"用户误把公网地址写成 http://"归为配置错误、未做防护。现已补三道防线：
        1) 构建期：:app 的 BASE_URL 由 -PBASE_URL / 环境变量注入，release 拒绝明文公网地址；
        2) 保存时：EndpointSafety 在登录页/我的页保存地址前校验，公网必须 HTTPS；
        3) 发请求前：HostSelectionInterceptor 与 ParentPushClient(WS) 各自复核，拒绝即失败。
      因此这里保留 true 只服务于「回环/私网 http」这一既定私有化口径，不再等于放行公网明文。
      若将来只支持云部署，可改为 networkSecurityConfig 按域名白名单放开。
    -->
    <application
        android:name=".PadGuardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PadGuardParent"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PadGuardParent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 微信支付结果回调页：路径必须是 <applicationId>.wxapi.WXPayEntryActivity（微信侧硬性约定，
             包名/类名改一个字调起和回调都会失败）。transparent 主题：微信拉起后返回时无闪屏 -->
        <activity
            android:name=".wxapi.WXPayEntryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.padguard.parent"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 高德地图 SDK Key（占位，由 build.gradle.kts 的 AMAP_KEY 注入；默认空 = 回退占位底图） -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_KEY}" />

    </application>

</manifest>
