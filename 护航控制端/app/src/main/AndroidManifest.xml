<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Push notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Location (for parent app - optional) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      明文传输开关保持 true —— 与孩子端同一决策，不是遗漏：
      家庭/校园局域网部署时服务端跑在内网（http + tcp），关掉会让家长端直接连不上；
      公网部署由 Nginx 终止 TLS，填 https:// 域名即走加密，本开关不影响其安全性。
      唯一的风险是"用户误把公网地址写成 http://"，那属于配置错误而非本开关造成。
      若将来只支持云部署，可改为 networkSecurityConfig 按域名白名单放开。
    -->
    <application
        android:name=".PadGuardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PadGuardParent"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PadGuardParent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 微信支付结果回调页：路径必须是 <applicationId>.wxapi.WXPayEntryActivity（微信侧硬性约定，
             包名/类名改一个字调起和回调都会失败）。transparent 主题：微信拉起后返回时无闪屏 -->
        <activity
            android:name=".wxapi.WXPayEntryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.padguard.parent"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 高德地图 SDK Key（占位，由 build.gradle.kts 的 AMAP_KEY 注入；默认空 = 回退占位底图） -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_KEY}" />

    </application>

</manifest>
